# GEMINI_API_KEY: Optional runtime AI features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# SERVER CONFIGURATION
PORT=3000
NODE_ENV="development"

# DATABASE: MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/creatorspace_marketplace?retryWrites=true&w=majority
# If not provided, an in-memory seed store seamlessly powers all API operations so the app works immediately.
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.mongodb.net/creatorspace_marketplace?retryWrites=true&w=majority"

# AUTHENTICATION
JWT_SECRET="creatorspace_super_secure_jwt_secret_key_2026_hackathon"
JWT_EXPIRES_IN="7d"

# CLOUDINARY MEDIA STORAGE
# Cloudinary provides CDN-hosted image and video transformation and storage.
# If omitted or unconfigured, the app offers instant local file uploads with preview & CDN fallbacks.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
